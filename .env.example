# 复制为 .env 后，替换所有 change-me 值。该文件不会被 Git 跟踪。
MYSQL_DATABASE=hermes_router
MYSQL_USER=hermes_router
MYSQL_PASSWORD=change-me-router-db-password
MYSQL_ROOT_PASSWORD=change-me-root-db-password

# 飞书机器人（长连接模式）
FEISHU_APP_NAME=主机器人
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=change-me-feishu-app-secret
FEISHU_STREAM_ENABLED=true
FEISHU_DEBUG_LOG_EVENTS=false

# 已部署的 Hermes Platform；Compose 不会启动或模拟该外部服务。
PLATFORM_BASE_URL=http://platform.example.internal
PLATFORM_USERNAME=platform-user
PLATFORM_PASSWORD=change-me-platform-password

# 后台登录。请生成专属 bcrypt 哈希和随机 session secret；缺失时 Compose 会拒绝启动。
ADMIN_PORT=8081
ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=
# ADMIN_SESSION_SECRET=
